DATABASE_URL=mysql+pymysql://attendance:attendance@localhost:3306/attendance?charset=utf8mb4
JWT_SECRET=change-me-in-production
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Read by docker-compose.yml (not by the app itself) to configure the `db`
# service and build the api container's DATABASE_URL (host `db`, not localhost).
# This file is gitignored — real deployments should set their own values here,
# never in docker-compose.yml, which is committed.
DB_NAME=attendance
DB_USER=attendance
DB_PASSWORD=attendance
DB_ROOT_PASSWORD=attendance
