# Copy to .env and edit. .env is gitignored and excluded from the Docker build
# context, so these values reach the container only via docker-compose.yml's
# `environment:` block.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# Only used when running uvicorn directly on the host (outside Docker). Under
# Docker, docker-compose.yml builds the URL itself and points it at host `db`,
# and that value wins over this one.
DATABASE_URL=mysql+pymysql://attendance:attendance@localhost:3306/attendance?charset=utf8mb4

# Generate a real one per environment: openssl rand -hex 32
# Changing it invalidates every token already issued.
JWT_SECRET=change-me-in-production

# Comma-separated browser origins allowed to call this API. Scheme and port
# must match exactly; no trailing slash, and do not use `*` in production. The
# frontend runs on a different hostname than the API, so its origin has to be
# listed here or the browser blocks every request with "No
# 'Access-Control-Allow-Origin' header is present".
#   local:      the web container (8400) and the Vite dev server (5173)
#   production: https://python.ccti.gt
CORS_ALLOWED_ORIGINS=http://localhost:8400,http://localhost:5173

# ---------------------------------------------------------------------------
# Database (read by docker-compose.yml, not by the app)
# ---------------------------------------------------------------------------

DB_NAME=attendance
DB_USER=attendance
DB_PASSWORD=attendance
DB_ROOT_PASSWORD=attendance

# Host port MySQL is published on, for local DB clients. Loopback-only either
# way; raise or change it if 33067 is taken.
#DB_PORT=33067

# ---------------------------------------------------------------------------
# Ports
# ---------------------------------------------------------------------------

# Host port the reverse proxy forwards python-api.ccti.gt to.
API_PORT=7400

# Interface to publish on. Leave as the loopback default when the reverse proxy
# runs on this same host; set 0.0.0.0 only if it does not.
#API_BIND=127.0.0.1

# ---------------------------------------------------------------------------
# Development switch
# ---------------------------------------------------------------------------

# Set to --reload locally for hot reloading on file changes. LEAVE IT EMPTY ON
# SERVERS: --reload runs a file-watching supervisor that is slower and not
# meant for production.
RELOAD=--reload
